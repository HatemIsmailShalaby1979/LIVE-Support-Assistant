# Environment contract.
#
# Copy to `.env.local` (gitignored) and fill in. Nothing here is read by the
# build today unless the comment says otherwise — this file exists so the
# missing pieces are visible rather than discovered mid-slice.
#
# There is no server in this repository. That is the single most important
# thing to know about this file: the client has no backend to point at yet.


# ---------------------------------------------------------------------------
# Read by code today
# ---------------------------------------------------------------------------

# apps/mobile — the tenant engine origin the WebView loads. Inlined into the
# Expo bundle at build time, so changing it requires a rebuild, not a restart.
# Defaults to http://localhost:4174 when unset.
EXPO_PUBLIC_ENGINE_ORIGIN=http://localhost:4174

# tooling/telemetry/verify-queue.mjs — set to 1 to reuse an already compiled
# copy of apps/web/src/telemetry.ts instead of recompiling it. Only useful when
# iterating on the harness itself.
# SOP_SKIP_COMPILE=1


# apps/web — the Supabase client. Vite only exposes VITE_-prefixed variables and
# inlines them at build time, so changing these needs a rebuild, not a restart.
# apps/web/src/supabase.ts throws at import time if either is missing, rather
# than failing later inside a request with a message about the network.
# The publishable key is safe to ship: row-level security is the actual boundary,
# and the secret key below must never reach this bundle.
#
# Running `pnpm dev` by hand? Vite reads `.env.local` from apps/web, not the repo
# root, so either copy these two into apps/web/.env.local or start the app
# through `pnpm run verify:signin`, which passes them from the root file.
# VITE_SUPABASE_URL=https://lxlokqtowvaesxjishqz.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=

# The browser's copy of the public halves of the publish function's keys. A device
# cannot verify a signature without the tenant's verify key, nor derive the shared
# secret without the server's public key, so these have to reach the bundle. They
# are public — nothing secret — and they must match the function's secrets exactly.
# Per-tenant in a real deployment; one set here because this project has one.
# VITE_TENANT_SIGNING_PUBLIC_KEY=
# VITE_SERVER_WRAPPING_PUBLIC_KEY=

# apps/web/src/supabase.ts also names the schema every RPC lives in. `app` has to
# be listed in the project's EXPOSED SCHEMAS or PostgREST answers
# "Invalid schema: app" for functions that exist and work. This is not set here:
# supabase/config.toml only configures local `supabase start`. A hosted project
# keeps the list in its own API settings, and the two have to be kept in step by
# hand. Nothing in the repository can enforce that.


# ---------------------------------------------------------------------------
# Server-side only. NOT read by any client code, and must never be bundled.
# ---------------------------------------------------------------------------
#
# SUPABASE_SECRET_KEY provisions fixture principals through the Auth Admin API
# (tooling/db/provision-hosted-fixtures.mjs, tooling/transport/probe-auth.mjs).
# This is the new name for the old service_role key. It bypasses RLS entirely.

# Public halves of the key material the publish edge function holds in the
# platform's secret store. A device cannot verify a signature without the
# tenant's verify key, and cannot derive the shared secret without the server's
# public key, so these have to be obtainable by the client. They are public —
# nothing here is secret — but they MUST match the function's secrets exactly, or
# every install fails at unwrap with no message naming the cause.
#
# The private halves never leave the platform. Set them with:
#   supabase secrets set --env-file <file containing all four values>
# SOP_TENANT_SIGNING_PUBLIC_KEY=
# SOP_SERVER_WRAPPING_PUBLIC_KEY=

# Supabase project: lxlokqtowvaesxjishqz
SUPABASE_URL=https://lxlokqtowvaesxjishqz.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase CLI and migration tooling, for CI where there is no credential store.
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=lxlokqtowvaesxjishqz
# SUPABASE_DB_PASSWORD=
